! special
*.foreground:   #ffffff
*.background:   #191817
*.cursorColor:  #ffffff

! black
*.color0:       #537b5d
*.color8:       #8da691

! red
*.color1:       #f06b54
*.color9:       #f5986a

! green
*.color2:       #bbbb88
*.color10:      #8dccb1

! yellow
*.color3:       #ff7d5e
*.color11:      #eedd99

! blue
*.color4:       #e0ba69
*.color12:      #4fa590

! magenta
*.color5:       #709092
*.color13:      #ffcbab

! cyan
*.color6:       #d13516
*.color14:      #c25431

! white
*.color7:       #58666f
*.color15:      #f9f1ed



!! Fonts

Xft.dpi:        92
Xft.antialias:  true
Xft.rgba:       rgb
Xft.hinting:    true
Xft.hintstyle:  hintslight

!! URxvt Appearance
URxvt*font: xft:DejaVuSansMono:pixelsize=12
URxvt.geometry: 102x32
URxvt.internalBorder: 24
URxvt.letterSpace: 0
Urxvt.lineSpace: 0
URxvt.cursorBlink: true
URxvt.cursorUnderline: false
URxvt.saveline: 2048
URxvt.scrollBar: false
URxvt.scrollBar_right: false
URxvt.urgentOnBell: true
URxvt.depth: 32
URxvt.iso14755: false
