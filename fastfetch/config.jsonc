{

    "logo": {
      //Use chafa for out.sixel >>   chafa -s WxH path/to/image > out.sixel
      "type": "raw",
      "source": "/home/$USER/out.sixel",
      "width": 38,//35,
      "padding": {
          "top": 3,
          "left": 2,
          "right": 0
      }
      
    },
    "display": {
      "separator": " ",
      "color": {
          "keys": "#c43333"
      }
    },

    "modules": [
        "break",
        "break",

        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Info─────────────────────────┐"
        },

        {
            "type": "custom",
            "key": "                 ☣",
            "format": "Richard Stein"
        },

        {
            "type": "custom",
            "key": "                    Overwatch",
            "format": ""
        },

        "break",

        {
            "type": "custom",
            "key": " \udb80\udd42",
            "format": "Choose your weapon, time to go."
        },

        "break",

        {
            "type": "command",
            "key": " ",
            "text": "printf '\uf017 %s %s                 ➟ %s@%s' $(date +%H:%M:%S) $(date +%Y-%m-%d) $(whoami) $(hostnamectl hostname)",
            "format": "{##c43333} {result}"
        },

        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[90m└───────────────────────────────────────────────────┘"
        },


        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[90m┌────────────────────Equipment──────────────────────┐"
        },

        "break",

        {
            "type": "os",
            "key": " OS \udb82\udcc7"  // https://www.nerdfonts.com/cheat-sheet
        },

        {
            "type": "host",
            "key": " Machine"
        },

        {
            "type": "kernel",
            "key": " Kernel"
        },

        {
            "type": "uptime",
            "key": " Up"
        },

        {
            "type": "packages",
            "key": " Packages"
        },

        {
            "type": "shell",
            "key": " Shell"
        },

        {
            "type": "wm",
            "key": " WM/DE"
        },

        {
            "type": "terminal",
            "key": " Terminal"
        },

        {
            "type": "cpu",
            "key": " CPU"
        },

        {
            "type": "disk",
            "key": " Disk",
            "format": "{size-used} / {size-total} - {9}"
        },

        {
            "type": "media",
            "key": " ⯈"
        },

        {
            "type": "custom",
            "format": "\u001b[90m└───────────────────────────────────────────────────┘"
        },

        {
            "type": "custom",
            "format": "                          \u001b[90mThe Combine Overwatch - CMb"
        }

    ]

}
