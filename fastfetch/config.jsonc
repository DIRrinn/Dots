{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
      //Use chafa for out.sixel >>   chafa -s WxH path/to/image > out.sixel
      "type": "raw",
      "source": "/home/$USER/out.sixel",
      "width": 35,
      "padding": {
          "top": 2,
          "left": 2,
          "right": 1
      }
      
    },
    "display": {
      "separator": " "
    },

    "modules": [
        "break",
        "break",

        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Info─────────────────────────┐"
        },

        {
            "type": "custom",
            "key": "                 ☣",
            "format": "Richard Stein"
        },

        {
            "type": "custom",
            "key": "                   Science Team",
            "format": ""
        },

        "break",

        {
            "type": "custom",
            "key": " 〉",
            "format": "The right man in the wrong place can make all the difference in the world."
        },

        "break",

        {
            "type": "command",
            "key": " ",
            "text": "printf '\uf017 %s %s                 ➟ %s@%s' $(date +%H:%M:%S) $(date +%Y-%m-%d) $(whoami) $(hostnamectl hostname)",
            "format": "{##13c299} {result}"
        },

        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[90m└───────────────────────────────────────────────────┘"
        },


        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[90m┌────────────────────Equipment──────────────────────┐"
        },

        "break",

        {
            "type": "os",
            "key": "OS \udb82\udcc7"  // https://www.nerdfonts.com/cheat-sheet
        },

        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "disk",

        {
            "type": "media",
            "key": "⯈"
        },

        {
            "type": "custom",
            "format": "\u001b[90m└───────────────────────────────────────────────────┘"
        },

        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }

    ]

}
