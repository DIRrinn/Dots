{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
      //Use chafa for out.sixel >>   chafa -s WxH path/to/image > out.sixel
      "type": "raw",
      "source": "out.sixel",
      "width": 35,
      "padding": {
          "top": 2,
          "left": 2,
          "right": 1
      }
      
    },
    "display": {
      "separator": " "
    },

    "modules": [
        "break",
        "break",
        "title",
        "separator",
        "datetime",
        "separator",
       
        {
            "type": "custom",
            "key": "Info",
            "format": "The right man in the wrong place can make all the difference in the world."
        },
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "disk",
        "media",
        "colors",
        "break"
    ]

}
