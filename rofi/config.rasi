configuration {
modes: "drun,run";
font: "Trebuchet MS 10";
location: 0;
yoffset: 0;
xoffset: 0;
fixed-num-lines: true;
show-icons: false;
terminal: "rofi-sensible-terminal";
run-command: "{cmd}";
run-list-command: "";
run-shell-command: "{terminal} -e {cmd}";
window-command: "wmctrl -i -R {window}";
window-match-fields: "all";
icon-theme: "adwaita";
drun-match-fields: "name,generic,exec,categories,keywords";
drun-show-actions: false;
drun-display-format: "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
drun-url-launcher: "xdg-open";
sort: false;
cycle: false;
sidebar-mode: false;
eh: 1;
auto-select: false;
display-window: "window";
display-run: " ";
display-ssh: "ssh";
display-drun: "󰣇 ";
}

* {
  border: 0;
  margin: 0;

  bg: #222222;
  fg: #ffffff;
  red: #c43333;

  background-color: transparent;
}

window {
    background-color:   @bg;
    border-color:       @fg;

    location:   center;
    width:      480px;
    border:     0px;
}

inputbar {
    padding:    0px 0px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg;
}

element {
    padding:    3px;
    spacing:    8px;
}

element selected normal {
    background-color:   @red;
}

listview {
  lines: 10;
  fixed-height:   false;
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}

element-icon {
    size:   0.75em;
}

  timeout {
      action: "kb-cancel";
      delay:  0;
}

//@theme "/usr/local/share/rofi/themes/Arc-Dark.rasi"
