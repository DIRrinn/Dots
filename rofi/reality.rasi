* {
    border: 0;
    margin: 0;
    padding: 2;
    spacing: 0;

    bg: #222222;
    black: #111111;
    fg: #dddddd;
    red: #c43333;

    background-color: @bg;
    text-color: @fg;
}

window {
    location:   center;
    width: 480px;
    border: 4px;
    border-color: @black;
}

inputbar, prompt, entry {
    border: 0px 0px 0px 0px;
    border-color: @black;
    padding: 3px 3px;
    background-color: @bg;
}

scrollbar {
    handle-color: @red;
    border: 0px;
    border-color: @black;
    handle-width: 5px;
    padding: 4;
}

element {
    background-color: @black;
    border: 2px;
    border-color: @bg;
    padding: 2px;
}

element selected normal {
    background-color: @red;
}

listview {
    scrollbar: false;
    lines: 8;
    fixed-height: false;
}

element-text, element-icon {
    highlight: none;
    vertical-align: 0.5;
    horizontal-align : 0.0;
    background-color: inherit;
}

entry {
    placeholder: "Search";
    placeholder-color: #888888;
}

element-text selected {
    text-color: @fg;
}
